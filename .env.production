# CARSTRIMS Backend - Production Config
APP_NAME=CARSTRIMS
DEBUG=false
FRONTEND_URL=https://carstrims.vercel.app

# MongoDB Atlas
MONGODB_URL=your_mongodb_atlas_connection_string

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-to-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=dkvj0wjta
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
